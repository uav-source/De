{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://degen-lio.local/schemas/harmful_bias/readonly_observation_v1.schema.json",
  "title": "FAST-LIO2 read-only observation tap v1",
  "oneOf": [
    {
      "$ref": "#/$defs/scanLifecycleRecord"
    },
    {
      "$ref": "#/$defs/firstValidObservationRecord"
    }
  ],
  "$defs": {
    "finiteNumber": {
      "type": "number"
    },
    "uint32": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "uint64": {
      "type": "integer",
      "minimum": 0,
      "maximum": 18446744073709551615
    },
    "point3": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "$ref": "#/$defs/finiteNumber"
      }
    },
    "plane4": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "$ref": "#/$defs/finiteNumber"
      }
    },
    "jacobianRow6": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "$ref": "#/$defs/finiteNumber"
      }
    },
    "covarianceRow6": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "$ref": "#/$defs/finiteNumber"
      }
    },
    "skipReason": {
      "type": "string",
      "enum": [
        "NONE",
        "FIRST_SCAN_INITIALIZATION",
        "EMPTY_UNDISTORTED_SCAN",
        "LOCAL_MAP_INITIALIZATION",
        "DOWNSAMPLED_POINTS_TOO_FEW",
        "FILTER_UPDATE_NOT_INVOKED",
        "NO_VALID_LINEARIZATION",
        "EXTRINSIC_ESTIMATION_ENABLED",
        "NONFINITE_OBSERVATION",
        "BUFFER_FULL",
        "INTERNAL_LIFECYCLE_ERROR"
      ]
    },
    "scanLifecycleRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_type",
        "schema_version",
        "synthetic_only",
        "scan_index",
        "timestamp_begin",
        "timestamp_end",
        "timestamp_unit",
        "tap_enabled",
        "update_invoked",
        "first_valid_linearization_found",
        "record_emitted",
        "measurement_call_count",
        "valid_measurement_call_count",
        "downsampled_point_count",
        "valid_correspondence_count",
        "skip_reason",
        "adapter_contract_version",
        "fastlio2_commit"
      ],
      "properties": {
        "record_type": {
          "const": "scan_lifecycle"
        },
        "schema_version": {
          "const": "fastlio2-readonly-observation-v1"
        },
        "synthetic_only": {
          "type": "boolean"
        },
        "scan_index": {
          "$ref": "#/$defs/uint64"
        },
        "timestamp_begin": {
          "$ref": "#/$defs/finiteNumber"
        },
        "timestamp_end": {
          "$ref": "#/$defs/finiteNumber"
        },
        "timestamp_unit": {
          "const": "seconds"
        },
        "tap_enabled": {
          "type": "boolean"
        },
        "update_invoked": {
          "type": "boolean"
        },
        "first_valid_linearization_found": {
          "type": "boolean"
        },
        "record_emitted": {
          "type": "boolean"
        },
        "measurement_call_count": {
          "$ref": "#/$defs/uint32"
        },
        "valid_measurement_call_count": {
          "$ref": "#/$defs/uint32"
        },
        "downsampled_point_count": {
          "$ref": "#/$defs/uint32"
        },
        "valid_correspondence_count": {
          "$ref": "#/$defs/uint32"
        },
        "skip_reason": {
          "$ref": "#/$defs/skipReason"
        },
        "adapter_contract_version": {
          "const": "fastlio2-readonly-observation-v1"
        },
        "fastlio2_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "firstValidObservationRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_type",
        "schema_version",
        "synthetic_only",
        "scan_index",
        "timestamp_begin",
        "timestamp_end",
        "timestamp_unit",
        "measurement_call_index",
        "record_version",
        "prior_position_world",
        "prior_position_frame",
        "prior_position_unit",
        "prior_orientation_world_from_imu_xyzw",
        "prior_orientation_from_frame",
        "prior_orientation_to_frame",
        "prior_orientation_representation",
        "prior_covariance_detector_order",
        "prior_covariance_native_dimension",
        "prior_covariance_order",
        "prior_covariance_unit_convention",
        "detector_pose_jacobian_rows",
        "detector_pose_jacobian_column_order",
        "detector_pose_jacobian_unit_convention",
        "signed_geometric_residual_pd2",
        "formal_filter_innovation_h",
        "residual_unit",
        "measurement_weight_representation",
        "measurement_variance_scalar_m2",
        "measurement_variance_applies_to_all_rows",
        "accepted_source_indices",
        "correspondence_proxy_ids",
        "plane_parameters_world",
        "plane_parameter_convention",
        "ordered_neighbor_coordinates_world",
        "neighbor_coordinate_frame",
        "neighbor_coordinate_unit",
        "valid_correspondence_count",
        "native_jacobian_column_count",
        "detector_jacobian_column_count",
        "checksum_algorithm",
        "formal_native_jacobian_checksum",
        "detector_jacobian_checksum",
        "formal_innovation_checksum",
        "geometric_residual_checksum",
        "accepted_index_checksum",
        "correspondence_proxy_checksum",
        "prior_covariance_checksum"
      ],
      "properties": {
        "record_type": {
          "const": "first_valid_observation"
        },
        "schema_version": {
          "const": "fastlio2-readonly-observation-v1"
        },
        "synthetic_only": {
          "type": "boolean"
        },
        "scan_index": {
          "$ref": "#/$defs/uint64"
        },
        "timestamp_begin": {
          "$ref": "#/$defs/finiteNumber"
        },
        "timestamp_end": {
          "$ref": "#/$defs/finiteNumber"
        },
        "timestamp_unit": {
          "const": "seconds"
        },
        "measurement_call_index": {
          "$ref": "#/$defs/uint32"
        },
        "record_version": {
          "const": "readonly_observation_v1"
        },
        "prior_position_world": {
          "$ref": "#/$defs/point3"
        },
        "prior_position_frame": {
          "const": "world"
        },
        "prior_position_unit": {
          "const": "meters"
        },
        "prior_orientation_world_from_imu_xyzw": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "$ref": "#/$defs/finiteNumber"
          }
        },
        "prior_orientation_from_frame": {
          "const": "imu"
        },
        "prior_orientation_to_frame": {
          "const": "world"
        },
        "prior_orientation_representation": {
          "const": "quaternion_xyzw"
        },
        "prior_covariance_detector_order": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "items": {
            "$ref": "#/$defs/covarianceRow6"
          }
        },
        "prior_covariance_native_dimension": {
          "const": 23
        },
        "prior_covariance_order": {
          "const": "delta_theta_xyz_then_delta_position_xyz"
        },
        "prior_covariance_unit_convention": {
          "const": "rotation_radians_then_translation_meters"
        },
        "detector_pose_jacobian_rows": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/jacobianRow6"
          }
        },
        "detector_pose_jacobian_column_order": {
          "const": "delta_theta_xyz_then_delta_position_xyz"
        },
        "detector_pose_jacobian_unit_convention": {
          "const": "meters_per_rotation_radian_then_meters_per_translation_meter"
        },
        "signed_geometric_residual_pd2": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/finiteNumber"
          }
        },
        "formal_filter_innovation_h": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/finiteNumber"
          }
        },
        "residual_unit": {
          "const": "meters"
        },
        "measurement_weight_representation": {
          "const": "CONSTANT_SCALAR_VARIANCE"
        },
        "measurement_variance_scalar_m2": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "measurement_variance_applies_to_all_rows": {
          "const": true
        },
        "accepted_source_indices": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/uint64"
          }
        },
        "correspondence_proxy_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/uint64"
          }
        },
        "plane_parameters_world": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/plane4"
          }
        },
        "plane_parameter_convention": {
          "const": "normalized_normal_xyz_and_offset_meters"
        },
        "ordered_neighbor_coordinates_world": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/point3"
            }
          }
        },
        "neighbor_coordinate_frame": {
          "const": "world"
        },
        "neighbor_coordinate_unit": {
          "const": "meters"
        },
        "valid_correspondence_count": {
          "$ref": "#/$defs/uint32"
        },
        "native_jacobian_column_count": {
          "const": 12
        },
        "detector_jacobian_column_count": {
          "const": 6
        },
        "checksum_algorithm": {
          "const": "FNV1A64_EXACT_BYTES_V1"
        },
        "formal_native_jacobian_checksum": {
          "$ref": "#/$defs/uint64"
        },
        "detector_jacobian_checksum": {
          "$ref": "#/$defs/uint64"
        },
        "formal_innovation_checksum": {
          "$ref": "#/$defs/uint64"
        },
        "geometric_residual_checksum": {
          "$ref": "#/$defs/uint64"
        },
        "accepted_index_checksum": {
          "$ref": "#/$defs/uint64"
        },
        "correspondence_proxy_checksum": {
          "$ref": "#/$defs/uint64"
        },
        "prior_covariance_checksum": {
          "$ref": "#/$defs/uint64"
        }
      }
    }
  }
}
