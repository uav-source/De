{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://degen-lio.local/schemas/harmful_bias/readonly_detector_output_v2.schema.json",
  "title": "Post-replay production detector output v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "record_version", "record_source", "run_id",
    "sequence_id", "detector_execution_mode", "scan_index",
    "timestamp_begin", "timestamp_end", "measurement_call_index",
    "input_observation_checksum", "detector_input_checksum",
    "detector_output_checksum", "detector_metric_version",
    "detector_entrypoint", "detector_source_sha256",
    "detector_config_sha256", "detector_lock_sha256",
    "detector_residual_input_field", "measurement_weight_representation",
    "valid_correspondence_count", "valid", "invalid_reason", "odi_trans",
    "ais_trans", "lambda_min_trans", "condition_number_trans",
    "translation_eigenvalues_ascending", "primary_weak_direction",
    "primary_weak_direction_frame", "primary_eigengap_ratio",
    "primary_direction_stable", "degeneracy_triggered",
    "actionable_direction", "synthetic_only"
  ],
  "properties": {
    "schema_version": {"const": "readonly_detector_output_v2"},
    "record_version": {"const": "readonly_detector_output_v2"},
    "record_source": {"const": "FASTLIO2_RUNTIME"},
    "run_id": {"type": "string", "minLength": 1},
    "sequence_id": {"enum": ["avia_quick_shack", "avia_outdoor_run_100hz"]},
    "detector_execution_mode": {"const": "POST_REPLAY_READONLY_PRODUCTION_DETECTOR"},
    "scan_index": {"type": "integer", "minimum": 0},
    "timestamp_begin": {"type": "number"},
    "timestamp_end": {"type": "number"},
    "measurement_call_index": {"type": "integer", "minimum": 0},
    "input_observation_checksum": {"$ref": "#/$defs/sha256"},
    "detector_input_checksum": {"$ref": "#/$defs/sha256"},
    "detector_output_checksum": {"$ref": "#/$defs/sha256"},
    "detector_metric_version": {"type": "string", "minLength": 1},
    "detector_entrypoint": {"const": "src/degen_detector/odi_tracker.py::compute_metrics_for_frame"},
    "detector_source_sha256": {"$ref": "#/$defs/sha256"},
    "detector_config_sha256": {"$ref": "#/$defs/sha256"},
    "detector_lock_sha256": {"$ref": "#/$defs/sha256"},
    "detector_residual_input_field": {"const": "formal_filter_innovation_h"},
    "measurement_weight_representation": {"const": "CONSTANT_SCALAR_VARIANCE"},
    "valid_correspondence_count": {"type": "integer", "minimum": 1},
    "valid": {"type": "boolean"},
    "invalid_reason": {"type": "string"},
    "odi_trans": {"$ref": "#/$defs/nullableNumber"},
    "ais_trans": {"$ref": "#/$defs/nullableNumber"},
    "lambda_min_trans": {"$ref": "#/$defs/nullableNumber"},
    "condition_number_trans": {"$ref": "#/$defs/nullableNumber"},
    "translation_eigenvalues_ascending": {},
    "primary_weak_direction": {},
    "primary_weak_direction_frame": {"const": "WORLD"},
    "primary_eigengap_ratio": {"$ref": "#/$defs/nullableNumber"},
    "primary_direction_stable": {"type": "boolean"},
    "degeneracy_triggered": {"type": "boolean"},
    "actionable_direction": {"type": "boolean"},
    "synthetic_only": {"const": false}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "nullableNumber": {"type": ["number", "null"]}
  }
}
