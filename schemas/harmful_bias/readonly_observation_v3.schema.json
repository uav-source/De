{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://degen-lio.local/schemas/harmful_bias/readonly_observation_v3.schema.json",
  "title": "FAST-LIO2 compact runtime read-only observation v3",
  "type": "object",
  "required": [
    "schema_version", "record_version", "record_source", "synthetic_only",
    "run_id", "sequence_id", "fastlio2_commit", "fastlio2_binary_sha256",
    "bag_sha256", "config_bundle_sha256", "adapter_contract_version",
    "scan_index", "timestamp_begin", "timestamp_end", "timestamp_unit",
    "measurement_call_index", "prior_position_world",
    "prior_orientation_world_from_imu_xyzw",
    "prior_covariance_detector_order_raw",
    "prior_covariance_detector_order_symmetric",
    "prior_covariance_max_asymmetry", "prior_covariance_raw_checksum",
    "detector_pose_jacobian_rows", "formal_filter_innovation_h",
    "signed_geometric_residual_pd2_derived",
    "measurement_variance_scalar_m2", "measurement_weight_representation",
    "measurement_variance_applies_to_all_rows", "valid_correspondence_count",
    "native_jacobian_column_count", "detector_jacobian_column_count",
    "checksum_algorithm", "formal_native_jacobian_checksum",
    "detector_jacobian_checksum", "formal_innovation_checksum",
    "geometric_residual_checksum", "accepted_index_checksum",
    "formal_correspondence_checksum", "binary_record_checksum"
  ],
  "properties": {
    "schema_version": {"const": "readonly_observation_v3"},
    "record_version": {"const": "readonly_observation_v3"},
    "record_source": {"const": "FASTLIO2_RUNTIME_COMPACT_BINARY"},
    "synthetic_only": {"const": false},
    "run_id": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+$"},
    "sequence_id": {"enum": ["avia_quick_shack", "avia_outdoor_run_100hz"]},
    "fastlio2_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "fastlio2_binary_sha256": {"$ref": "#/$defs/sha256"},
    "bag_sha256": {"$ref": "#/$defs/sha256"},
    "config_bundle_sha256": {"$ref": "#/$defs/sha256"},
    "adapter_contract_version": {"const": "fastlio2-readonly-observation-v3"},
    "scan_index": {"$ref": "#/$defs/uint64"},
    "timestamp_begin": {"type": "number"},
    "timestamp_end": {"type": "number"},
    "timestamp_unit": {"const": "seconds"},
    "measurement_call_index": {"$ref": "#/$defs/uint32"},
    "prior_position_world": {"$ref": "#/$defs/vector3"},
    "prior_orientation_world_from_imu_xyzw": {"$ref": "#/$defs/vector4"},
    "prior_covariance_detector_order_raw": {"$ref": "#/$defs/matrix6"},
    "prior_covariance_detector_order_symmetric": {"$ref": "#/$defs/matrix6"},
    "prior_covariance_max_asymmetry": {"type": "number", "minimum": 0},
    "prior_covariance_raw_checksum": {"$ref": "#/$defs/uint64"},
    "detector_pose_jacobian_rows": {
      "type": "array", "minItems": 1,
      "items": {"type": "array", "minItems": 6, "maxItems": 6, "items": {"type": "number"}}
    },
    "formal_filter_innovation_h": {"type": "array", "minItems": 1, "items": {"type": "number"}},
    "signed_geometric_residual_pd2_derived": {"const": true},
    "measurement_variance_scalar_m2": {"type": "number", "exclusiveMinimum": 0},
    "measurement_weight_representation": {"const": "CONSTANT_SCALAR_VARIANCE"},
    "measurement_variance_applies_to_all_rows": {"const": true},
    "valid_correspondence_count": {"type": "integer", "minimum": 1},
    "native_jacobian_column_count": {"const": 12},
    "detector_jacobian_column_count": {"const": 6},
    "checksum_algorithm": {"const": "FNV1A64_EXACT_BYTES_V1"},
    "formal_native_jacobian_checksum": {"$ref": "#/$defs/uint64"},
    "detector_jacobian_checksum": {"$ref": "#/$defs/uint64"},
    "formal_innovation_checksum": {"$ref": "#/$defs/uint64"},
    "geometric_residual_checksum": {"$ref": "#/$defs/uint64"},
    "accepted_index_checksum": {"$ref": "#/$defs/uint64"},
    "formal_correspondence_checksum": {"$ref": "#/$defs/uint64"},
    "binary_record_checksum": {"$ref": "#/$defs/uint64"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "uint32": {"type": "integer", "minimum": 0, "maximum": 4294967295},
    "uint64": {"type": "integer", "minimum": 0, "maximum": 18446744073709551615},
    "vector3": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number"}},
    "vector4": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "number"}},
    "matrix6": {
      "type": "array", "minItems": 6, "maxItems": 6,
      "items": {"type": "array", "minItems": 6, "maxItems": 6, "items": {"type": "number"}}
    }
  }
}
