{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "phase_a_scientific_protocol_lock_v2.schema.json",
  "title": "Phase A Scientific Protocol Lock v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "lock_type", "lock_version",
    "source_legacy_protocol_path", "source_legacy_protocol_sha256",
    "scenes", "geometry_seeds", "measurement_seeds", "repeat_indices", "condition",
    "backend_algorithms", "backend_versions", "backend_parameters",
    "transform_semantics", "translation_metric", "rotation_metric_semantics",
    "quantile_method", "qualification_gates", "failure_definitions",
    "planned_snapshot_count", "planned_trial_count", "allowed_backends",
    "forbidden_backends", "scientific_payload_sha256"
  ],
  "properties": {
    "schema_version": {"const": "phase_a_scientific_protocol_lock_v2"},
    "lock_type": {"const": "phase_a_scientific_protocol_lock"},
    "lock_version": {"const": "2"},
    "source_legacy_protocol_path": {"type": "string", "minLength": 1},
    "source_legacy_protocol_sha256": {"$ref": "#/$defs/sha256"},
    "scenes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "geometry_seeds": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/seed"}},
    "measurement_seeds": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/seed"}},
    "repeat_indices": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "integer", "minimum": 0}},
    "condition": {"type": "string", "minLength": 1},
    "backend_algorithms": {"type": "object", "minProperties": 2},
    "backend_versions": {"type": "object", "minProperties": 2},
    "backend_parameters": {"type": "object", "minProperties": 2},
    "transform_semantics": {"type": "object", "minProperties": 1},
    "translation_metric": {"type": "object", "minProperties": 1},
    "rotation_metric_semantics": {"type": "object", "minProperties": 1},
    "quantile_method": {"type": "string", "minLength": 1},
    "qualification_gates": {"type": "object", "minProperties": 1},
    "failure_definitions": {"type": "object", "minProperties": 1},
    "planned_snapshot_count": {"const": 210},
    "planned_trial_count": {"const": 420},
    "allowed_backends": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "string"}},
    "forbidden_backends": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "scientific_payload_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "seed": {
      "type": "object",
      "additionalProperties": false,
      "required": ["index", "label", "value"],
      "properties": {
        "index": {"type": "integer", "minimum": 0},
        "label": {"type": "string", "minLength": 1},
        "value": {"type": "integer", "minimum": 0}
      }
    }
  }
}
